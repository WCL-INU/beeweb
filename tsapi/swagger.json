        "description": "Endpoint to add a new area",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "테스트"
                },
                "location": {
                  "type": "string",
                  "example": "37.375, 126.633"
                }
              },
              "required": [
                "name",
